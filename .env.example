# Unica variable que llega al navegador. La URL publica de la instancia de
# PocketBase (el SDK del cliente la usa para el login y para la pantalla
# editable de bas_category_map).
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# URL publica del backend Python (invoice-api-bas). El boton "Reintentar"
# de la pantalla de ordenes de pago le pega directo a
# {NEXT_PUBLIC_INVOICE_API_BAS_URL}/gemini2/retry-op/{process_id} desde el
# navegador; ese backend es el que reintenta de verdad contra BAS ERP.
NEXT_PUBLIC_INVOICE_API_BAS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Variables server-only (revision + orden de pago). Nunca se exponen al
# navegador -- Next.js solo las inyecta en codigo que corre en el servidor
# (Route Handlers bajo app/api/: proxy del archivo original de una factura,
# creacion de la Orden de Pago). Si faltan, esos dos Route Handlers devuelven
# 500 -- el resto del dashboard sigue funcionando igual.
#
# POCKETBASE_INTERNAL_URL: mismo motivo que server-only de arriba. En Docker
# es el DNS interno (http://pocketbase:8090); en dev local sin Docker, si se
# omite, cae a NEXT_PUBLIC_POCKETBASE_URL (mismo host).
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090
# En Docker es http://invoice-api-bas:8000; en dev local sin Docker, si se
# omite, cae a NEXT_PUBLIC_INVOICE_API_BAS_URL (mismo host).
INVOICE_API_BAS_INTERNAL_URL=http://127.0.0.1:8000
# MISMO valor que el SECRET_KEY real de invoice-api-bas (ver ticket-ai-infra/.env)
# -- protege los dos Route Handlers de arriba contra el backend Python.
SECRET_KEY=
# ---------------------------------------------------------------------------
